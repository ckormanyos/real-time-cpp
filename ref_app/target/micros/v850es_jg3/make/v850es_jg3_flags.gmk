# ------------------------------------------------------------------------------
# compiler flags for the target architecture
# ------------------------------------------------------------------------------

GCC_VERSION   = 16.2.0
GCC_TARGET    = v850-unknown-elf
GCC_PREFIX    = v850-unknown-elf

TGT_SUFFIX    = elf

TGT_ALLFLAGS  = -O2                                            \
                -mv850es                                       \
                -mtda=0                                        \
                -msda=0                                        \
                -Wl,--defsym=__gp=0                            \
                -Wl,--defsym=__ep=0                            \
                -falign-functions=4                            \
                -fomit-frame-pointer                           \
                -finline-functions                             \
                -finline-limit=32

TGT_CFLAGS    = -std=c23                                       \
                -Wunsuffixed-float-constants                   \
                $(TGT_ALLFLAGS)

TGT_CXXFLAGS  = -std=c++23                                     \
                $(TGT_ALLFLAGS)

TGT_INCLUDES := -isystem $(PATH_APP)/util/STL
TGT_INCLUDES :=

TGT_AFLAGS    =

TGT_LDFLAGS   = -nostdlib                                      \
                -nostartfiles                                  \
                -Wl,--gc-sections                              \
                -Wl,-Map,$(APP).map                            \
                -T $(LINKER_DEFINITION_FILE)
