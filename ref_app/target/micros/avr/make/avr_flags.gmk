# ------------------------------------------------------------------------------
# compiler flags for the target architecture
# ------------------------------------------------------------------------------

GCC_TARGET    = avr
GCC_PREFIX    = avr

GCC_VERSION   = 16.2.0

TGT_SUFFIX    = elf

TGT_ALLFLAGS  = -O2                                                               \
                -mmcu=atmega328p                                                  \
                -mrelax                                                           \
                -finline-functions                                                \
                -finline-limit=64                                                 \
                -fsigned-char

ifeq ($(TYP_OS),WIN)

TGT_ALLFLAGS := $(TGT_ALLFLAGS)                                                   \
                -mdouble=64                                                       \
                -mlong-double=64

INC_PREFIX   := -isystem
STD_CPP      := c++23

else

INC_PREFIX   := -I
STD_CPP      := c++17

endif

STD_C        := c20

TGT_CFLAGS    = -std=$(STD_C)                                                     \
                $(TGT_ALLFLAGS)

TGT_CXXFLAGS  = -std=$(STD_CPP)                                                   \
                $(TGT_ALLFLAGS)

TGT_INCLUDES := $(INC_PREFIX)$(PATH_APP)/util/STL

#TGT_INCLUDES := $(INC_PREFIX)$(PATH_APP)/util/STL_avr-libstdcpp/90ddfd4a/gcc16/include

TGT_AFLAGS    =

TGT_LDFLAGS   = -nostdlib                                                         \
                -nostartfiles                                                     \
                -Wl,--gc-sections                                                 \
                -Wl,-Map,$(APP).map                                               \
                -T $(LINKER_DEFINITION_FILE)
