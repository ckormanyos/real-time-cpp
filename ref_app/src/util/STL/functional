    namespace xfunctional_impl
    {
#if (__cplusplus < 201703L)
      template<typename argument1, typename argument2, typename result>
      struct binary_function_base : std::binary_function<argument1, argument2, result> { };

      template<typename argument, typename result>
      struct unary_function_base : std::unary_function<argument, result> { };
#else
      template<typename, typename, typename>
      struct binary_function_base { };

      template<typename, typename>
      struct unary_function_base { };
#endif
    }

    template<typename operand_type = void>
    struct plus : public xfunctional_impl::binary_function_base<operand_type, operand_type, operand_type>
    {
      operand_type operator()(const operand_type& left, const operand_type& right) const
      {
        return left + right;
      }
    };

    template<>
    struct plus<void>
    {
      using is_transparent = void;

      template<typename Left, typename Right>
      constexpr auto operator()(Left&& left, Right&& right) const
        noexcept(noexcept(std::forward<Left>(left) + std::forward<Right>(right)))
        -> decltype(std::forward<Left>(left) + std::forward<Right>(right))
      {
        return std::forward<Left>(left) + std::forward<Right>(right);
      }
    };

    template<typename operand_type>
    struct minus : public xfunctional_impl::binary_function_base<operand_type, operand_type, operand_type>
    {
      operand_type operator()(const operand_type& left, const operand_type& right) const
      {
        return left - right;
      }
    };

    template<typename operand_type>
    struct negate : public xfunctional_impl::unary_function_base<operand_type, operand_type>
    {
      operand_type operator()(const operand_type& value) const
      {
        return -value;
      }
    };

