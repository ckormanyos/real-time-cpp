    template<typename Signature>
    class function;

    template<typename Return, typename... Args>
    class function<Return(Args...)>
    {
    public:
      using result_type = Return;
      using function_pointer = Return (*)(Args...);

      function() noexcept : my_vtable(nullptr) { }

      function(std::nullptr_t) noexcept : my_vtable(nullptr) { }

      function(function_pointer callable) : my_vtable(nullptr)
      {
        if(callable != nullptr)
        {
          initialize<function_pointer>(callable);
        }
      }

      function(const function& other) : my_vtable(other.my_vtable)
      {
        if(my_vtable != nullptr)
        {
          my_vtable->copy(static_cast<void*>(my_storage.bytes),
                          static_cast<const void*>(other.my_storage.bytes));
        }
      }

      function(function&& other) : my_vtable(nullptr)
      {
        if(other.my_vtable != nullptr)
        {
          const vtable_type* const other_vtable = other.my_vtable;
          other_vtable->move(static_cast<void*>(my_storage.bytes),
                             static_cast<void*>(other.my_storage.bytes));
          my_vtable = other_vtable;
          other.my_vtable = nullptr;
        }
      }

      template<typename Callable,
               typename StoredCallable = typename std::decay<Callable>::type,
               typename = std::enable_if_t<!std::is_same<StoredCallable, function>::value>>
      function(Callable&& callable) : my_vtable(nullptr)
      {
        initialize<StoredCallable>(std::forward<Callable>(callable));
      }

      ~function() { reset(); }

      auto operator=(const function& other) -> function&
      {
        if(this != &other)
        {
          function copy(other);
          *this = std::move(copy);
        }

        return *this;
      }

      auto operator=(function&& other) -> function&
      {
        if(this != &other)
        {
          reset();

          if(other.my_vtable != nullptr)
          {
            const vtable_type* const other_vtable = other.my_vtable;
            other_vtable->move(static_cast<void*>(my_storage.bytes),
                               static_cast<void*>(other.my_storage.bytes));
            my_vtable = other_vtable;
            other.my_vtable = nullptr;
          }
        }

        return *this;
      }

      auto operator=(std::nullptr_t) noexcept -> function&
      {
        reset();
        return *this;
      }

      template<typename Callable>
      auto operator=(Callable&& callable) -> function&
      {
        function temporary(std::forward<Callable>(callable));
        *this = std::move(temporary);
        return *this;
      }

      explicit operator bool() const noexcept { return (my_vtable != nullptr); }

      auto operator()(Args... args) const -> Return
      {
        if(my_vtable == nullptr)
        {
          std::abort();
        }

        return my_vtable->invoke(const_cast<void*>(static_cast<const void*>(my_storage.bytes)),
                                 std::forward<Args>(args)...);
      }

      auto swap(function& other) -> void
      {
        if(this != &other)
        {
          function temporary(std::move(*this));
          *this = std::move(other);
          other = std::move(temporary);
        }
      }

      template<typename Target>
      auto target() noexcept -> Target*
      {
        using stored_type = typename std::remove_cv<Target>::type;

        return((my_vtable != nullptr) && (my_vtable->type_key() == type_key<stored_type>()))
            ? static_cast<Target*>(static_cast<void*>(my_storage.bytes))
            : nullptr;
      }

      template<typename Target>
      auto target() const noexcept -> const Target*
      {
        using stored_type = typename std::remove_cv<Target>::type;

        return((my_vtable != nullptr) && (my_vtable->type_key() == type_key<stored_type>()))
            ? static_cast<const Target*>(static_cast<const void*>(my_storage.bytes))
            : nullptr;
      }

    private:
      static constexpr std::size_t storage_size = (sizeof(void*) * 3U);

      struct storage_type
      {
        alignas(std::max_align_t) unsigned char bytes[storage_size];
      };

      struct vtable_type
      {
        Return (*invoke)(void*, Args...);
        void (*copy)(void*, const void*);
        void (*move)(void*, void*);
        void (*destroy)(void*);
        const void* (*type_key)();
      };

      template<typename Callable>
      static auto invoke_target(void* target, Args... args) -> Return
      {
        return xfunctional_impl::function_invoke<Return>::call(
          *static_cast<Callable*>(target), std::forward<Args>(args)...);
      }

      template<typename Callable>
      static auto copy_target(void* destination, const void* source) -> void
      {
        new(destination) Callable(*static_cast<const Callable*>(source));
      }

      template<typename Callable>
      static auto move_target(void* destination, void* source) -> void
      {
        Callable* const source_callable = static_cast<Callable*>(source);
        new(destination) Callable(*source_callable);
        source_callable->~Callable();
      }

      template<typename Callable>
      static auto destroy_target(void* target) -> void
      {
        static_cast<Callable*>(target)->~Callable();
      }

      template<typename Callable>
      static const void* type_key() noexcept
      {
        static const unsigned char key = 0U;
        return static_cast<const void*>(&key);
      }

      template<typename Callable>
      static const vtable_type* vtable_for() noexcept
      {
        static const vtable_type table =
        {
          &invoke_target<Callable>,
          &copy_target<Callable>,
          &move_target<Callable>,
          &destroy_target<Callable>,
          &type_key<Callable>
        };

        return &table;
      }

      template<typename Callable, typename Value>
      auto initialize(Value&& callable) -> void
      {
        static_assert(std::is_copy_constructible<Callable>::value,
                      "std::function targets must be copy constructible");
        static_assert(sizeof(Callable) <= storage_size,
                      "std::function target exceeds inline storage capacity");
        static_assert(alignof(Callable) <= alignof(storage_type),
                      "std::function target alignment exceeds inline storage alignment");

        new(static_cast<void*>(my_storage.bytes)) Callable(std::forward<Value>(callable));
        my_vtable = vtable_for<Callable>();
      }

      auto reset() noexcept -> void
      {
        if(my_vtable != nullptr)
        {
          my_vtable->destroy(static_cast<void*>(my_storage.bytes));
          my_vtable = nullptr;
        }
      }

      storage_type          my_storage;
      const vtable_type*     my_vtable;
    };

