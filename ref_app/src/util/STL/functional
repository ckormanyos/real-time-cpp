      template<typename... Args>
      class bind_call_arguments
      {
      public:
        static constexpr std::size_t size = sizeof...(Args);

        explicit bind_call_arguments(Args&&... args) : values(args...) { }

        std::tuple<typename std::remove_reference<Args>::type&...> values;
      };

      template<std::size_t N, typename... Args>
      auto get_call_argument(bind_call_arguments<Args...>&& args)
        -> typename std::tuple_element<N, std::tuple<Args...>>::type&&
      {
        using result_type = typename std::tuple_element<N, std::tuple<Args...>>::type&&;
        return static_cast<result_type>(std::get<N>(args.values));
      }

      template<int N>
      struct placeholder_getter
      {
        template<typename Tuple>
        static auto get(Tuple&& args)
          -> decltype(get_call_argument<static_cast<std::size_t>(N - 1)>(std::forward<Tuple>(args)))
        {
          return get_call_argument<static_cast<std::size_t>(N - 1)>(std::forward<Tuple>(args));
        }
      };

      template<>
      struct placeholder_getter<0> { };

      template<typename T>
      struct bind_call_argument_count;

      template<typename... Args>
      struct bind_call_argument_count<bind_call_arguments<Args...>>
        : std::integral_constant<std::size_t, sizeof...(Args)> { };

      template<int N>
      struct placeholder { };

      template<typename Callable, typename... BoundArgs>
      class bind_wrapper;
