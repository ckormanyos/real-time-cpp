      inline auto hash_u64(std::uint64_t value) noexcept -> std::size_t
      {
        std::size_t result = static_cast<std::size_t>(2166136261UL);

        for(std::size_t index = 0U; index < sizeof(value); ++index)
        {
          result ^= static_cast<std::size_t>(value & std::uint64_t { 0xFFU });
          result *= static_cast<std::size_t>(16777619UL);
          value >>= 8U;
        }

        return result;
      }

      inline auto hash_bytes(const unsigned char* bytes, std::size_t count) noexcept -> std::size_t
      {
        std::size_t result = static_cast<std::size_t>(2166136261UL);

        for(std::size_t index = 0U; index < count; ++index)
        {
          result ^= static_cast<std::size_t>(bytes[index]);
          result *= static_cast<std::size_t>(16777619UL);
        }

        return result;
      }

      template<typename T>
      auto hash_floating(T value) noexcept -> std::size_t
      {
        if(value == T(0))
        {
          value = T(0);
        }

        unsigned char bytes[sizeof(T)] { };
        std::memcpy(bytes, &value, sizeof(value));

        return hash_bytes(bytes, sizeof(value));
      }

      template<typename T>
      auto hash_dispatch(const T& value, std::false_type) noexcept -> std::size_t
      {
        return hash_u64(static_cast<std::uint64_t>(value));
      }

      template<typename T>
      auto hash_dispatch(T value, std::true_type) noexcept -> std::size_t
      {
        return hash_floating(value);
      }
    }

    template <typename T>
    struct hash
    {
        auto operator()(const T& value) const noexcept -> std::size_t
        {
          return xfunctional_impl::hash_dispatch(value, std::is_floating_point<T> { });
        }
    };

    template <typename T>
    struct hash<T*>
    {
      auto operator()(T* value) const noexcept -> std::size_t
      {
        return xfunctional_impl::hash_u64(static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(value)));
      }
    };

    template <>
    struct hash<std::nullptr_t>
    {
      auto operator()(std::nullptr_t) const noexcept -> std::size_t
      {
        return xfunctional_impl::hash_u64(0U);
      }
    };

    namespace xfunctional_impl
    {
      template <typename T> constexpr T& func_ref_or_moveref(T& t) noexcept { return t; }
      template <typename T> void func_ref_or_moveref(T&&) = delete;
    }

    template<typename T>
    class reference_wrapper
    {
    public:
      typedef T type;

      template<typename U,
               class = decltype(xfunctional_impl::func_ref_or_moveref<T>(std::declval<U>()),
                                std::enable_if_t<(!std::is_same<reference_wrapper,
                                                               typename std::remove_cv<typename std::remove_reference<U>::type>::type>::value)>())>
      constexpr reference_wrapper(U&& u) noexcept(noexcept(xfunctional_impl::func_ref_or_moveref<T>(std::forward<U>(u))))
        : my_ptr(std::addressof(xfunctional_impl::func_ref_or_moveref<T>(std::forward<U>(u)))) { }

      reference_wrapper(const reference_wrapper&) noexcept = default;

      reference_wrapper& operator=(const reference_wrapper& x) noexcept = default;

      constexpr operator T& () const noexcept { return *my_ptr; }
      constexpr T& get() const noexcept { return *my_ptr; }

      template<class... ArgTypes>
      constexpr auto operator()(ArgTypes&&... args) const
        noexcept(noexcept(get()(std::forward<ArgTypes>(args)...)))
        -> decltype(get()(std::forward<ArgTypes>(args)...))
      {
        return get()(std::forward<ArgTypes>(args)...);
      }

    private:
      T* my_ptr;
    };

    namespace xfunctional_impl
    {
      template<typename T>
      struct is_reference_wrapper : std::false_type { };

      template<typename T>
      struct is_reference_wrapper<std::reference_wrapper<T>> : std::true_type { };

      template<typename C, typename Obj>
      constexpr auto member_object_direct(Obj&& object, std::true_type) noexcept
        -> decltype(std::forward<Obj>(object))
      {
        return std::forward<Obj>(object);
      }

      template<typename C, typename Obj>
      constexpr auto member_object_direct(Obj&& object, std::false_type)
        noexcept(noexcept(*std::forward<Obj>(object)))
        -> decltype(*std::forward<Obj>(object))
      {
        return *std::forward<Obj>(object);
      }

      template<typename C, typename Obj>
      constexpr auto member_object(Obj&& object, std::true_type)
        noexcept(noexcept(std::forward<Obj>(object).get()))
        -> decltype(std::forward<Obj>(object).get())
      {
        return std::forward<Obj>(object).get();
      }

      template<typename C, typename Obj>
      constexpr auto member_object(Obj&& object, std::false_type)
        noexcept(noexcept(member_object_direct<C>(std::forward<Obj>(object),
                       std::is_base_of<C, typename std::remove_cv<typename std::remove_reference<Obj>::type>::type> { })))
        -> decltype(member_object_direct<C>(std::forward<Obj>(object),
                     std::is_base_of<C, typename std::remove_cv<typename std::remove_reference<Obj>::type>::type> { }))
      {
        return member_object_direct<C>(std::forward<Obj>(object),
                 std::is_base_of<C, typename std::remove_cv<typename std::remove_reference<Obj>::type>::type> { });
      }

      template<typename T>
      struct is_member_function_pointer : std::false_type { };

      template<typename M, typename C>
      struct is_member_function_pointer<M C::*> : std::is_function<M> { };

      template<typename MemberPointer, bool = is_member_function_pointer<MemberPointer>::value>
      struct member_pointer_invoker;

      template<typename M, typename C>
      struct member_pointer_invoker<M C::*, true>
      {
        template<typename Obj, typename... Args>
        static constexpr auto call(M C::* member, Obj&& object, Args&&... args)
          noexcept(noexcept((member_object<C>(std::forward<Obj>(object),
                                 is_reference_wrapper<typename std::decay<Obj>::type> { }).*member)
                            (std::forward<Args>(args)...)))
          -> decltype((member_object<C>(std::forward<Obj>(object),
                                        is_reference_wrapper<typename std::decay<Obj>::type> { }).*member)
                      (std::forward<Args>(args)...))
        {
          return (member_object<C>(std::forward<Obj>(object),
                                   is_reference_wrapper<typename std::decay<Obj>::type> { }).*member)
                 (std::forward<Args>(args)...);
        }
      };

      template<typename M, typename C>
      struct member_pointer_invoker<M C::*, false>
      {
        template<typename Obj>
        static constexpr auto call(M C::* member, Obj&& object)
          noexcept(noexcept(member_object<C>(std::forward<Obj>(object),
                                 is_reference_wrapper<typename std::decay<Obj>::type> { }).*member))
          -> decltype(member_object<C>(std::forward<Obj>(object),
                                       is_reference_wrapper<typename std::decay<Obj>::type> { }).*member)
        {
          return member_object<C>(std::forward<Obj>(object),
                                  is_reference_wrapper<typename std::decay<Obj>::type> { }).*member;
        }
      };

      template<typename MemberPointer>
      class mem_fn_wrapper
      {
      public:
        explicit constexpr mem_fn_wrapper(MemberPointer member) noexcept : my_member_pointer(member) { }

        template<typename Obj, typename... Args>
        constexpr auto operator()(Obj&& object, Args&&... args) const
          noexcept(noexcept(member_pointer_invoker<MemberPointer>::call(std::declval<MemberPointer>(),
                                    std::forward<Obj>(object), std::forward<Args>(args)...)))
          -> decltype(member_pointer_invoker<MemberPointer>::call(std::declval<MemberPointer>(),
                             std::forward<Obj>(object), std::forward<Args>(args)...))
        {
          return member_pointer_invoker<MemberPointer>::call(this->my_member_pointer,
                   std::forward<Obj>(object), std::forward<Args>(args)...);
        }

      private:
        MemberPointer my_member_pointer;
      };
    }

    template<typename M, typename C>
    constexpr auto mem_fn(M C::* member) noexcept
      -> xfunctional_impl::mem_fn_wrapper<M C::*>
    {
      return xfunctional_impl::mem_fn_wrapper<M C::*>(member);
    }

    template<typename T>
    constexpr reference_wrapper<T> ref(T& value) noexcept
    {
      return reference_wrapper<T>(value);
    }

    template<typename T>
    constexpr reference_wrapper<T> ref(reference_wrapper<T> value) noexcept
    {
      return value;
    }

    template<typename T>
    void ref(const T&&) = delete;

    template<typename T>
    constexpr reference_wrapper<const T> cref(const T& value) noexcept
