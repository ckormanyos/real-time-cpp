      inline auto hash_u64(std::uint64_t value) noexcept -> std::size_t
      {
        std::size_t result = static_cast<std::size_t>(2166136261UL);

        for(std::size_t index = 0U; index < sizeof(value); ++index)
        {
          result ^= static_cast<std::size_t>(value & std::uint64_t { 0xFFU });
          result = static_cast<std::size_t>(static_cast<std::uint64_t>(result) * std::uint64_t { 16777619U });
          value >>= 8U;
        }

        return result;
      }

      inline auto hash_bytes(const unsigned char* bytes, std::size_t count) noexcept -> std::size_t
      {
        std::size_t result = static_cast<std::size_t>(2166136261UL);

        for(std::size_t index = 0U; index < count; ++index)
        {
          result ^= static_cast<std::size_t>(bytes[index]);
          result = static_cast<std::size_t>(static_cast<std::uint64_t>(result) * std::uint64_t { 16777619U });
        }

        return result;
      }

      template<typename T>
      auto hash_floating(T value) noexcept -> std::size_t
      {
        if(!(value < T(0)) && !(value > T(0)))
        {
          value = T(0);
        }

        unsigned char bytes[sizeof(T)] { };
        std::memcpy(bytes, &value, sizeof(value));

        return hash_bytes(bytes, sizeof(value));
      }

      template<typename T>
      auto hash_dispatch(const T& value, std::false_type) noexcept -> std::size_t
      {
        return hash_u64(static_cast<std::uint64_t>(value));
      }

      template<typename T>
      auto hash_dispatch(T value, std::true_type) noexcept -> std::size_t
      {
        return hash_floating(value);
      }
    }

