      template<typename Bound, typename Tuple, std::size_t... Indices>
      auto invoke_nested(Bound&& bound, Tuple&& args, index_sequence<Indices...>)
        -> decltype(std::forward<Bound>(bound)(get_call_argument<Indices>(std::forward<Tuple>(args))...))
      {
        return std::forward<Bound>(bound)(get_call_argument<Indices>(std::forward<Tuple>(args))...);
      }

      template<typename Bound, typename Tuple>
      auto resolve_bound(Bound&& bound, Tuple&& args,
                         std::integral_constant<int, 0>, std::false_type, std::false_type)
        -> decltype(std::forward<Bound>(bound))
      {
        return std::forward<Bound>(bound);
      }

      template<typename Bound, typename Tuple>
      auto resolve_bound(Bound&& bound, Tuple&&,
                         std::integral_constant<int, 0>, std::true_type, std::false_type)
        -> decltype(std::forward<Bound>(bound).get())
      {
        return std::forward<Bound>(bound).get();
      }

      template<int N, typename Bound, typename Tuple, std::enable_if_t<(N > 0), int> = 0>
      auto resolve_bound(Bound&&, Tuple&& args,
                         std::integral_constant<int, N>, std::false_type, std::false_type)
        -> decltype(placeholder_getter<N>::get(std::forward<Tuple>(args)))
      {
        return placeholder_getter<N>::get(std::forward<Tuple>(args));
      }

      template<typename Bound, typename Tuple>
      auto resolve_bound(Bound&& bound, Tuple&& args,
                         std::integral_constant<int, 0>, std::false_type, std::true_type)
        -> decltype(invoke_nested(std::forward<Bound>(bound), std::forward<Tuple>(args),
                     typename make_index_sequence<bind_call_argument_count<typename std::decay<Tuple>::type>::value>::type { }))
      {
        return invoke_nested(std::forward<Bound>(bound), std::forward<Tuple>(args),
                 typename make_index_sequence<bind_call_argument_count<typename std::decay<Tuple>::type>::value>::type { });
      }

      template<typename Bound, typename Tuple>
      auto resolve_bound(Bound&& bound, Tuple&& args)
        -> decltype(resolve_bound(std::forward<Bound>(bound), std::forward<Tuple>(args),
                     std::integral_constant<int, std::is_placeholder<typename std::decay<Bound>::type>::value> { },
                     is_reference_wrapper<typename std::decay<Bound>::type> { },
                     std::is_bind_expression<typename std::decay<Bound>::type> { }))
      {
        return resolve_bound(std::forward<Bound>(bound), std::forward<Tuple>(args),
                 std::integral_constant<int, std::is_placeholder<typename std::decay<Bound>::type>::value> { },
                 is_reference_wrapper<typename std::decay<Bound>::type> { },
                 std::is_bind_expression<typename std::decay<Bound>::type> { });
      }

      template<typename Callable, typename BoundTuple, typename CallTuple, std::size_t... Indices>
      auto invoke_bound(Callable&& callable, BoundTuple&& bound_args, CallTuple&& call_args,
                        index_sequence<Indices...>)
        -> decltype(bind_invoke(std::forward<Callable>(callable),
                     std::is_member_pointer<typename std::decay<Callable>::type> { },
                     resolve_bound(std::get<Indices>(std::forward<BoundTuple>(bound_args)),
                                   std::forward<CallTuple>(call_args))...))
      {
        return bind_invoke(std::forward<Callable>(callable),
                 std::is_member_pointer<typename std::decay<Callable>::type> { },
                 resolve_bound(std::get<Indices>(std::forward<BoundTuple>(bound_args)),
                               std::forward<CallTuple>(call_args))...);
      }

      template<typename Callable, typename... BoundArgs>
      class bind_wrapper
      {
      public:
        template<typename F, typename... Args>
        explicit bind_wrapper(F&& callable, Args&&... args)
          : my_callable(std::forward<F>(callable)),
            my_bound_args(std::forward<Args>(args)...) { }

        template<typename... CallArgs>
        auto operator()(CallArgs&&... args) const
          -> decltype(invoke_bound(std::declval<const Callable&>(),
                       std::declval<const std::tuple<BoundArgs...>&>(),
                       std::declval<bind_call_arguments<CallArgs...>&&>(),
                       typename make_index_sequence<sizeof...(BoundArgs)>::type { }))
        {
          bind_call_arguments<CallArgs...> call_args(std::forward<CallArgs>(args)...);

          return invoke_bound(my_callable,
                   my_bound_args,
                   std::move(call_args),
                   typename make_index_sequence<sizeof...(BoundArgs)>::type { });
        }

      private:
        Callable my_callable;
        std::tuple<BoundArgs...> my_bound_args;
      };
    }

    template<typename Callable, typename... BoundArgs>
    auto bind(Callable&& callable, BoundArgs&&... args)
      -> xfunctional_impl::bind_wrapper<typename std::decay<Callable>::type,
                                        typename std::decay<BoundArgs>::type...>
    {
      using bind_type = xfunctional_impl::bind_wrapper<typename std::decay<Callable>::type,
                                                       typename std::decay<BoundArgs>::type...>;

      return bind_type(std::forward<Callable>(callable), std::forward<BoundArgs>(args)...);
    }

