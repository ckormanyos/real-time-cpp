    template<typename T>
    struct equal_to : public xfunctional_impl::binary_function_base<T, T, bool>
    {
      bool operator()(const T& left, const T& right) const
      {
        return (left == right);
      }
    };

    template<typename T>
    struct not_equal_to : public xfunctional_impl::binary_function_base<T, T, bool>
    {
      bool operator()(const T& left, const T& right) const
      {
