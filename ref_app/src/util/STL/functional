    template<typename T>
    class reference_wrapper
    {
    public:
      typedef T type;

      template<typename U,
               class = decltype(xfunctional_impl::func_ref_or_moveref<T>(std::declval<U>()),
                                std::enable_if_t<(!std::is_same<reference_wrapper,
                                                               typename std::remove_cv<typename std::remove_reference<U>::type>::type>::value)>())>
      constexpr reference_wrapper(U&& u) noexcept(noexcept(xfunctional_impl::func_ref_or_moveref<T>(std::forward<U>(u))))
        : my_ptr(std::addressof(xfunctional_impl::func_ref_or_moveref<T>(std::forward<U>(u)))) { }

      reference_wrapper(const reference_wrapper&) noexcept = default;

      auto operator=(const reference_wrapper& x) noexcept -> reference_wrapper& = default;

      constexpr operator T& () const noexcept { return *my_ptr; }
      constexpr auto get() const noexcept -> T& { return *my_ptr; }

      template<class... ArgTypes>
      constexpr auto operator()(ArgTypes&&... args) const
        noexcept(noexcept(std::declval<const reference_wrapper&>().get()(std::forward<ArgTypes>(args)...)))
        -> decltype(std::declval<const reference_wrapper&>().get()(std::forward<ArgTypes>(args)...))
      {
        return get()(std::forward<ArgTypes>(args)...);
      }

    private:
      T* my_ptr;
    };

