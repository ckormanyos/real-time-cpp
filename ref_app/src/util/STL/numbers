#ifndef NUMBERS_2026_11_12_
  #define NUMBERS_2026_11_12_

  namespace std
  {
    namespace numbers
    {
      // e_v             : mathematical constant e
      // log2e_v         : base-2 log of e (i.e., log_2(e))
      // log10e_v        : base-10 log of e (i.e., log_10(e))
      // pi_v the        : mathematical constant pi
      // inv_pi_v        : 1 / pi
      // inv_sqrtpi_v    : 1 / sqrt(pi)
      // ln2_v           : natural log of 2 (i.e., ln(2))
      // ln10_v          : natural log of 10 (i.e., ln(10))
      // sqrt2_v         : sqrt(2)
      // sqrt3_v         : sqrt(3)
      // inv_sqrt3_v     : 1 / sqrt(3)
      // egamma_v        : Euler�Mascheroni constant
      // phi_v           : golden ratio

      // Use N[Pi, 40] or similar
      template <typename T> constexpr T pi_v      = static_cast<T>(3.141592653589793238462643383279502884197L);
      template <typename T> constexpr T sqrt2_v   = static_cast<T>(1.414213562373095048801688724209698078570L);
      template <typename T> constexpr T egamma_v  = static_cast<T>(0.5772156649015328606065120900824024310422L);

      inline constexpr double pi      = pi_v<double>;
      inline constexpr double sqrt2   = sqrt2_v<double>;
      inline constexpr double egamma  = egamma_v<double>;

    } // namespace numbers
  } // namespace std

#endif // NUMBERS_2026_11_12_
